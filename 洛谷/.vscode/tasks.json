{
    "options": {
        "env": {
            "Path": "D:\\C++\\RedPanda.C++\\mingw64\\bin;${env:Path}"
        }
    },
    "tasks": [
        {
            "args": [
                "-g",
                "${file}",
                "-pedantic",
                "-g3",
                "-O2",
                "-std=c++14",
                "-pipe",
                "-Wall",
                "-Wextra",
                "-D_DEBUG",
                "-m64",
                "-pg",
                "-Wl",
                "--stack,1073741824",
                "-fsanitize=address,undefined,leak",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "command": "D:\\C++\\RedPanda.C++\\mingw64\\bin\\g++.exe",
            "group": "build",
            "label": "single file build",
            "presentation": {
                "clear": true,
                "echo": false,
                "focus": false,
                "panel": "shared",
                "reveal": "silent",
                "showReuseMessage": false
            },
            "problemMatcher": "$gcc",
            "type": "process"
        },
        {
            "type": "cppbuild",
            "label": "C/C++: g++.exe 生成活动文件（非调试）",
            "command": "D:\\C++\\RedPanda.C++\\mingw64\\bin\\g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe",
                "${file}",
                "-pedantic",
                "-O2",
                "-std=c++14",
                "-pipe",
                "-Wall",
                "-Wextra",
                "-D_DEBUG",
                "-m64",
                "-pg",
                "-Wl,--stack,1073741824",
                "-static"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "detail": "调试器生成的任务。"
        },
        {
            "type": "cppbuild",
            "label": "C/C++: g++.exe 生成活动文件（调试）",
            "command": "D:\\C++\\RedPanda.C++\\mingw64\\bin\\g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe",
                "-g",
                "${file}",
                "-pedantic",
                "-g3",
                "-O0",
                "-std=c++14",
                "-pipe",
                "-Wall",
                "-Wextra",
                "-D_DEBUG",
                "-m64",
                "-pg",
                "-Wl,--stack,1073741824",
                "-static"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "detail": "调试器生成的任务。"
        },
        {
            "type": "cppbuild",
            "label": "C/C++: g++.exe 生成活动文件",
            "command": "D:\\C++\\RedPanda.C++\\mingw64\\bin\\g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "调试器生成的任务。"
        }
    ],
    "version": "2.0.0"
}