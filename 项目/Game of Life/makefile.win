# Project: Game of Life
# Makefile created by Red Panda C++ 3.2.2958

CXX      = "g++.exe"
CC       = "gcc.exe"
WINDRES  = "windres.exe"
RM       = del /q /f
CD       = cd /d
LIBS     = "-m64" "-pg" "-Wl,--stack,1073741824" "-lraylib" "-lopengl32" "-lgdi32" "-lwinmm" "-static"
INCS     = 
CXXINCS  = 
CXXFLAGS = $(CXXINCS) "-pedantic" "-g3" "-O2" "-std=c++2b" "-pipe" "-Wall" "-Wextra" "-D_DEBUG"
CFLAGS   = $(INCS) "-std=c17" "-pedantic" "-g3" "-O2" "-pipe" "-Wall" "-Wextra" "-D_DEBUG"
WINDRESFLAGS = 
RES      = Game_of_Life_private.res
OBJ      = main.o $(RES)
BIN      = Game\ of\ Life.exe
LINKOBJ  = "main.o" "Game_of_Life_private.res"
CLEANOBJ = "main.o" "Game_of_Life_private.res" "Game of Life.exe"

.PHONY: all all-before all-after clean clean-custom

all: all-before $(BIN) all-after

clean: clean-custom
	-$(RM) $(CLEANOBJ) >NUL 2>&1

Game\ of\ Life.exe: $(OBJ)

	$(CXX) $(LINKOBJ) -o "Game of Life.exe" $(LIBS)

main.o: main.cpp
	$(CXX) -c "main.cpp" -o "main.o" $(CXXFLAGS) 

Game_of_Life_private.res: Game_of_Life_private.rc 
	$(WINDRES) -i "Game_of_Life_private.rc" --input-format=rc -o "Game_of_Life_private.res" -O coff $(WINDRESFLAGS) 

