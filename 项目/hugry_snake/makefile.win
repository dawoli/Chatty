# Project: hugry_snake
# Makefile created by Red Panda C++ 3.2.2958

CXX      = "g++.exe"
CC       = "gcc.exe"
WINDRES  = "windres.exe"
RM       = del /q /f
CD       = cd /d
LIBS     = "-m64" "-pg" "-Wl,--stack,1073741824" "-lraylib" "-lopengl32" "-lgdi32" "-lwinmm" "-static"
INCS     = 
CXXINCS  = 
CXXFLAGS = $(CXXINCS) "-pedantic" "-g3" "-O2" "-std=c++2b" "-pipe" "-Wall" "-Wextra" "-D_DEBUG"
CFLAGS   = $(INCS) "-std=c17" "-pedantic" "-g3" "-O2" "-pipe" "-Wall" "-Wextra" "-D_DEBUG"
WINDRESFLAGS = 
RES      = hugry_snake_private.res
OBJ      = main.o $(RES)
BIN      = hugry_snake.exe
LINKOBJ  = "main.o" "hugry_snake_private.res"
CLEANOBJ = "main.o" "hugry_snake_private.res" "hugry_snake.exe"

.PHONY: all all-before all-after clean clean-custom

all: all-before $(BIN) all-after

clean: clean-custom
	-$(RM) $(CLEANOBJ) >NUL 2>&1

hugry_snake.exe: $(OBJ)

	$(CXX) $(LINKOBJ) -o "hugry_snake.exe" $(LIBS)

main.o: main.c
	$(CC) -c "main.c" -o "main.o" $(CFLAGS) 

hugry_snake_private.res: hugry_snake_private.rc 
	$(WINDRES) -i "hugry_snake_private.rc" --input-format=rc -o "hugry_snake_private.res" -O coff $(WINDRESFLAGS) 

